            const acc = getActiveAccount();
            if (!acc) return;
            document.getElementById('clients-grid').innerHTML = acc.clients.map(c => `<div class="border rounded p-4 bg-gray-50"><h4 class="font-bold">${c.name}</h4><p class="text-sm">Rate: ${c.currency || acc.currency}${c.rate}/hr</p></div>`).join('');
        }

        window.loadUnbilledEntries = function() {
            const acc = getActiveAccount();
            if (!acc) return;
            const clientId = document.getElementById('inv-client').value;
            const container = document.getElementById('unbilled-container');
            const unbilled = acc.timeLogs.filter(l => l.clientId === clientId && l.billable && !l.invoiced);
            container.innerHTML = unbilled.length === 0 ? `<p class="text-gray-500">No unbilled time entries found.</p>` : unbilled.map(l => `<label class="flex items-center space-x-2"><input type="checkbox" value="${l.id}" checked class="inv-checkbox h-4 w-4"><span>${l.date} - ${l.hours} hrs</span></label>`).join('');
        };

        window.generateInvoice = function() {
            const acc = getActiveAccount();
            if (!acc) return;
            const clientId = document.getElementById('inv-client').value;
            const selectedIds = Array.from(document.querySelectorAll('.inv-checkbox:checked')).map(cb => cb.value);
            if (!clientId || selectedIds.length === 0) return alert('Select client and items.');
            
            const entries = acc.timeLogs.filter(l => selectedIds.includes(l.id));
            const total = entries.reduce((sum, curr) => sum + (curr.hours * curr.rate), 0);
            acc.invoices.push({ id: 'INV-' + Math.floor(1000 + Math.random() * 9000), clientId, entries: selectedIds, total, date: new Date().toISOString().split('T')[0] });
            acc.timeLogs.forEach(l => { if (selectedIds.includes(l.id)) l.invoiced = true; });
            window.saveAccounts();
            alert('Invoice generated!');
        };

        window.mergeSelectedInvoices = function() {
            const acc = getActiveAccount();
            if (!acc) return;
            const checkedBoxes = Array.from(document.querySelectorAll('.merge-inv-checkbox:checked'));
            if (checkedBoxes.length < 2) return alert('Select at least 2 invoices to merge.');
            const selectedIds = checkedBoxes.map(cb => cb.value);
            const target = acc.invoices.filter(i => selectedIds.includes(i.id));
            const firstClientId = target[0].clientId;
            if (!target.every(i => i.clientId === firstClientId)) return alert('Invoices must belong to the same client.');

            const combinedEntries = target.flatMap(i => i.entries);
            const combinedTotal = target.reduce((s, i) => s + i.total, 0);
            const merged = { id: 'INV-MERGED-' + Math.floor(1000 + Math.random() * 9000), clientId: firstClientId, entries: combinedEntries, total: combinedTotal, date: new Date().toISOString().split('T')[0], mergedFrom: selectedIds };

            acc.invoices = acc.invoices.filter(i => !selectedIds.includes(i.id));
            acc.invoices.push(merged);
            window.saveAccounts();
            alert('Invoices merged successfully!');
        };

        function renderInvoices() {
            const acc = getActiveAccount();
            const container = document.getElementById('invoices-list');
            if (!acc || acc.invoices.length === 0) { container.innerHTML = `<p class="text-gray-500 text-sm">No invoices yet.</p>`; return; }
            container.innerHTML = acc.invoices.map(inv => `<div class="border p-3 rounded flex justify-between items-center"><div class="flex items-center space-x-2"><input type="checkbox" value="${inv.id}" class="merge-inv-checkbox h-4 w-4"><span><strong>${inv.id}</strong> - Total: $${inv.total.toFixed(2)}</span></div></div>`).join('');
        }

        function renderCatalog() {
            const acc = getActiveAccount();
            if (!acc) return;
            document.getElementById('catalog-list').innerHTML = acc.catalog.map(item => `<li class="py-2 flex justify-between"><span>${item.name}</span><span>~${item.hours} hrs</span></li>`).join('');
        }

        function renderDashboard() {
            const acc = getActiveAccount();
            if (!acc) return;
            const totalHours = acc.timeLogs.reduce((sum, curr) => sum + curr.hours, 0);
            const totalBillable = acc.timeLogs.filter(l => l.billable).reduce((sum, curr) => sum + (curr.hours * curr.rate), 0);
            document.getElementById('stat-total-hours').innerText = totalHours.toFixed(1);
            document.getElementById('stat-total-billable').innerText = acc.currency + totalBillable.toFixed(2);
            document.getElementById('stat-active-clients').innerText = acc.clients.length;

            if (clientChartInstance) clientChartInstance.destroy();
            clientChartInstance = new Chart(document.getElementById('chartClientHours').getContext('2d'), {
                type: 'bar',
                data: { labels: acc.clients.map(c => c.name), datasets: [{ label: 'Hours', data: acc.clients.map(c => acc.timeLogs.filter(l => l.clientId === c.id).reduce((s, b) => s + b.hours, 0)), backgroundColor: '#3b82f6' }] }
            });
        }
    </script>
</head>
<body class="bg-gray-100 text-gray-900 font-sans">
    <!-- AUTH MODAL -->
    <div id="user-auth-modal" class="fixed inset-0 bg-slate-900 bg-opacity-95 flex items-center justify-center p-4 z-50">
        <div class="bg-white rounded-xl shadow-2xl max-w-md w-full p-6 space-y-4">
            <div class="flex justify-around border-b pb-3">
                <button id="auth-tab-login" onclick="switchAuthTab('login')" class="font-bold text-sm text-blue-600 border-b-2 border-blue-600 pb-1">Sign In</button>
                <button id="auth-tab-signup" onclick="switchAuthTab('signup')" class="font-bold text-sm text-gray-500 pb-1">Sign Up</button>
            </div>
            <button onclick="handleGoogleSignIn()" class="w-full border border-gray-300 hover:bg-gray-50 text-slate-700 font-semibold py-2.5 px-4 rounded-md text-sm flex items-center justify-center space-x-2">
                <span>Continue with Google</span>
            </button>
            <form id="login-form" onsubmit="handleLoginSubmit(event)" class="space-y-3">
                <input type="email" id="login-email" required placeholder="Email" class="w-full border rounded p-2 text-sm">
                <input type="password" id="login-password" required placeholder="Password" class="w-full border rounded p-2 text-sm">
                <button type="submit" class="w-full bg-blue-600 text-white p-2 rounded text-sm font-semibold">Sign In</button>
            </form>
            <form id="signup-form" onsubmit="handleSignupSubmit(event)" class="space-y-3 hidden">
                <input type="email" id="signup-email" required placeholder="Email" class="w-full border rounded p-2 text-sm">
                <input type="password" id="signup-password" required placeholder="Password (min 6 chars)" class="w-full border rounded p-2 text-sm">
                <input type="password" id="signup-password-confirm" required placeholder="Confirm Password" class="w-full border rounded p-2 text-sm">
                <button type="submit" class="w-full bg-green-600 text-white p-2 rounded text-sm font-semibold">Register Account</button>
            </form>
        </div>
    </div>

    <!-- COMPANY REGISTRATION MODAL -->
    <div id="auth-modal" class="fixed inset-0 bg-slate-900 bg-opacity-95 flex items-center justify-center p-4 z-50 hidden">
        <div class="bg-white rounded-xl shadow-2xl max-w-lg w-full p-6 space-y-4 relative">
            <button onclick="closeRegistrationModal()" class="absolute top-4 left-4 text-xs font-semibold text-gray-500">← Back</button>
            <h2 class="text-xl font-bold text-center pt-2">Register Company Workspace</h2>
            <form onsubmit="handleRegistration(event)" class="space-y-3">
                <input type="text" id="reg-company-name" required placeholder="Company Name" class="w-full border rounded p-2 text-sm">
                <select id="reg-industry" class="w-full border rounded p-2 text-sm">
                    <option value="Software Development">Software & App Development</option>
                    <option value="Graphic & UI/UX Design">Graphic, Web & UI/UX Design</option>
                    <option value="Digital Marketing">Digital Marketing & Growth Agency</option>
                    <option value="Legal Services">Legal Services & Corporate Law</option>
                    <option value="Accounting & Tax">Accounting, Audit & Tax Advisory</option>
                    <option value="HR & Recruitment">Human Resources & Staffing Agency</option>
                    <option value="Construction & Architecture">Construction & Architecture Firm</option>
                    <option value="Management & Strategy">Management & Business Strategy</option>
                    <option value="SAP Consulting">SAP / Enterprise IT Consulting</option>
                    <option value="General Freelance / Other">General Consulting & Services</option>
                </select>
                <select id="reg-currency-select" class="w-full border rounded p-2 text-sm">
                    <option value="$">USD ($)</option>
                    <option value="€">EUR (€)</option>
                    <option value="£">GBP (£)</option>
                    <option value="₹">INR (₹)</option>
                </select>
                <input type="number" id="reg-rate" value="120" class="w-full border rounded p-2 text-sm">
                <button type="submit" class="w-full bg-blue-600 text-white p-2 rounded text-sm font-semibold">Create Workspace</button>
            </form>
            <div id="switch-company-container" class="hidden border-t pt-2 text-center">
                <select id="existing-companies-select" onchange="switchCompanyAccount(this.value)" class="w-full border rounded p-2 text-xs"></select>
            </div>
        </div>
    </div>

    <!-- APP SHELL -->
    <div class="min-h-screen flex flex-col">
        <header class="bg-slate-900 text-white shadow">
            <div class="max-w-7xl mx-auto px-4 py-3 flex justify-between items-center">
                <div>
                    <h1 id="app-brand-title" class="text-xl font-bold">Business Activity Tracker</h1>
                    <p id="app-brand-subtitle" class="text-xs text-slate-400">Cloud Synced PWA</p>
                </div>
                <div class="flex items-center space-x-3">
                    <span id="logged-user-display" class="text-xs text-slate-300"></span>
                    <button onclick="openRegistrationModal()" class="bg-slate-800 text-xs px-3 py-1.5 rounded border border-slate-700">🏢 Switch Company</button>
                    <button onclick="handleLogout()" class="bg-red-800 text-xs px-3 py-1.5 rounded">Logout</button>
                </div>
            </div>
            <div class="max-w-7xl mx-auto px-4 flex space-x-1 overflow-x-auto bg-slate-950 py-1">
                <button onclick="switchTab('dashboard')" class="tab-btn px-4 py-2 rounded-t font-medium text-sm bg-white text-slate-900">Dashboard</button>
                <button onclick="switchTab('log-time')" class="tab-btn px-4 py-2 rounded-t font-medium text-sm text-slate-300">Log Time</button>
                <button onclick="switchTab('projects')" class="tab-btn px-4 py-2 rounded-t font-medium text-sm text-slate-300">Projects & Tasks</button>
                <button onclick="switchTab('clients')" class="tab-btn px-4 py-2 rounded-t font-medium text-sm text-slate-300">Clients & Currencies</button>
                <button onclick="switchTab('invoices')" class="tab-btn px-4 py-2 rounded-t font-medium text-sm text-slate-300">Invoices</button>
                <button onclick="switchTab('catalog')" class="tab-btn px-4 py-2 rounded-t font-medium text-sm text-slate-300">Activity Catalog</button>
            </div>
        </header>

        <main class="max-w-7xl mx-auto px-4 py-6 flex-grow w-full space-y-6">
            <!-- DASHBOARD -->
            <div id="tab-dashboard" class="tab-content space-y-6">
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div class="bg-white p-4 rounded shadow border-l-4 border-blue-600"><p class="text-sm text-gray-500">Total Hours</p><p id="stat-total-hours" class="text-2xl font-bold">0.0</p></div>
                    <div class="bg-white p-4 rounded shadow border-l-4 border-green-600"><p class="text-sm text-gray-500">Total Billed</p><p id="stat-total-billable" class="text-2xl font-bold">$0.00</p></div>
                    <div class="bg-white p-4 rounded shadow border-l-4 border-purple-600"><p class="text-sm text-gray-500">Clients</p><p id="stat-active-clients" class="text-2xl font-bold">0</p></div>
                </div>
                <div class="bg-white p-4 rounded shadow"><canvas id="chartClientHours" height="100"></canvas></div>
            </div>

            <!-- LOG TIME -->
            <div id="tab-log-time" class="tab-content hidden space-y-6">
                <div class="bg-white p-6 rounded shadow max-w-2xl">
                    <h3 class="text-lg font-semibold mb-4">Record Working Hours</h3>
                    <form onsubmit="handleLogTime(event)" class="space-y-4">
                        <div class="grid grid-cols-2 gap-4">
                            <div><label class="block text-sm">Client</label><select id="log-client" onchange="onClientChange()" required class="w-full border rounded p-2 bg-white text-sm"></select></div>
                            <div><label class="block text-sm">Project</label><select id="log-project" onchange="onProjectChange()" required class="w-full border rounded p-2 bg-white text-sm"></select></div>
                        </div>
                        <div class="grid grid-cols-2 gap-4">
                            <div><label class="block text-sm">Task</label><select id="log-task" required class="w-full border rounded p-2 bg-white text-sm"></select></div>
                            <div><label class="block text-sm">Hours</label><input type="number" step="0.25" id="log-hours" required class="w-full border rounded p-2 text-sm"></div>
                        </div>
                        <div class="grid grid-cols-2 gap-4">
                            <div><label class="block text-sm">Rate (<span id="log-currency-symbol">$</span>)</label><input type="number" id="log-rate" required class="w-full border rounded p-2 text-sm"></div>
                            <div class="flex items-center pt-5"><label class="flex items-center space-x-2"><input type="checkbox" id="log-billable" checked class="h-4 w-4"><span class="text-sm">Billable</span></label></div>
                        </div>
                        <div><label class="block text-sm">Notes</label><textarea id="log-notes" rows="2" class="w-full border rounded p-2 text-sm"></textarea></div>
                        <button type="submit" class="w-full bg-blue-600 text-white p-2 rounded text-sm font-semibold">Save Time Entry</button>
                    </form>
                </div>
                <div class="bg-white p-6 rounded shadow"><table class="min-w-full text-sm"><tbody id="time-logs-table"></tbody></table></div>
            </div>

            <!-- PROJECTS & TASKS -->
            <div id="tab-projects" class="tab-content hidden space-y-6">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="bg-white p-6 rounded shadow space-y-3">
                        <h3 class="text-lg font-semibold">Manage Projects</h3>
                        <form onsubmit="handleAddProject(event)" class="space-y-3">
                            <input type="text" id="proj-name" placeholder="Project Name" required class="w-full border rounded p-2 text-sm">
                            <select id="proj-client" required class="w-full border rounded p-2 text-sm bg-white"></select>
                            <textarea id="proj-desc" placeholder="Project Description" class="w-full border rounded p-2 text-sm"></textarea>
                            <button type="submit" class="bg-blue-600 text-white text-sm p-2 rounded">Add Project</button>
                        </form>
                        <ul id="projects-list" class="space-y-1 text-sm max-h-48 overflow-y-auto"></ul>
                    </div>
                    <div class="bg-white p-6 rounded shadow space-y-3">
                        <h3 class="text-lg font-semibold">Manage Tasks</h3>
                        <form onsubmit="handleAddTask(event)" class="space-y-3">
                            <input type="text" id="task-name" placeholder="Task Name" required class="w-full border rounded p-2 text-sm">
                            <select id="task-project" required class="w-full border rounded p-2 text-sm bg-white"></select>
                            <input type="number" step="0.5" id="task-est-hrs" placeholder="Estimated Hours" class="w-full border rounded p-2 text-sm">
                            <button type="submit" class="bg-blue-600 text-white text-sm p-2 rounded">Add Task</button>
                        </form>
                        <ul id="tasks-list" class="space-y-1 text-sm max-h-48 overflow-y-auto"></ul>
                    </div>
                </div>
            </div>

            <!-- CLIENTS -->
            <div id="tab-clients" class="tab-content hidden space-y-6">
                <div class="bg-white p-6 rounded shadow max-w-xl space-y-3">
                    <h3 class="text-lg font-semibold">Add Client</h3>
                    <form onsubmit="handleAddClient(event)" class="space-y-3">
                        <input type="text" id="client-name" required placeholder="Client Name" class="w-full border rounded p-2 text-sm">
                        <select id="client-currency-select" class="w-full border rounded p-2 text-sm bg-white"><option value="$">USD ($)</option><option value="€">EUR (€)</option><option value="£">GBP (£)</option><option value="₹">INR (₹)</option></select>
                        <input type="number" id="client-rate" required value="120" class="w-full border rounded p-2 text-sm">
                        <button type="submit" class="bg-blue-600 text-white p-2 rounded text-sm">Save Client</button>
                    </form>
                </div>
                <div class="bg-white p-6 rounded shadow"><div id="clients-grid" class="grid grid-cols-3 gap-4"></div></div>
            </div>

            <!-- INVOICES -->
            <div id="tab-invoices" class="tab-content hidden space-y-6">
                <div class="bg-white p-6 rounded shadow max-w-xl space-y-4">
                    <h3 class="text-lg font-semibold">Generate Invoice</h3>
                    <select id="inv-client" onchange="loadUnbilledEntries()" class="w-full border rounded p-2 text-sm bg-white"></select>
                    <div id="unbilled-container" class="border p-3 rounded bg-gray-50 text-sm">Select a client.</div>
                    <button onclick="generateInvoice()" class="bg-green-600 text-white p-2 rounded text-sm font-semibold">Create Invoice</button>
                </div>
                <div class="bg-white p-6 rounded shadow space-y-3">
                    <div class="flex justify-between items-center border-b pb-2">
                        <h3 class="font-semibold">Generated Invoices</h3>
                        <button onclick="mergeSelectedInvoices()" class="bg-purple-600 text-white text-xs px-3 py-1.5 rounded">Merge Selected Invoices</button>
                    </div>
                    <div id="invoices-list" class="space-y-2"></div>
                </div>
            </div>

            <!-- CATALOG -->
            <div id="tab-catalog" class="tab-content hidden space-y-6">
                <div class="bg-white p-6 rounded shadow max-w-xl space-y-3">
                    <h3 class="text-lg font-semibold">Activity Catalog</h3>
                    <form onsubmit="handleAddCatalogItem(event)" class="space-y-3">
                        <input type="text" id="catalog-new-name" required placeholder="Activity Name" class="w-full border rounded p-2 text-sm">
                        <input type="number" step="0.5" id="catalog-new-hrs" required placeholder="Estimated Hours" class="w-full border rounded p-2 text-sm">
                        <button type="submit" class="bg-blue-600 text-white text-sm p-2 rounded">Add Catalog Item</button>
                    </form>
                    <ul id="catalog-list" class="divide-y text-sm"></ul>
                </div>
            </div>
        </main>
    </div>
</body>
</html>
