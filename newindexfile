            e.preventDefault();
            const acc = getActiveAccount();
            if (!acc) return;
            acc.timeLogs.push({
                id: 'log_' + Date.now(),
                date: new Date().toISOString().split('T')[0],
                clientId: document.getElementById('log-client').value,
                projectId: document.getElementById('log-project').value,
                taskId: document.getElementById('log-task').value,
                hours: parseFloat(document.getElementById('log-hours').value),
                rate: parseFloat(document.getElementById('log-rate').value),
                billable: document.getElementById('log-billable').checked,
                notes: document.getElementById('log-notes').value,
                invoiced: false
            });
            document.getElementById('log-hours').value = '';
            document.getElementById('log-notes').value = '';
            window.saveAccounts();
        };

        function renderTimeLogs() {
            const acc = getActiveAccount();
            const tbody = document.getElementById('time-logs-table');
            if (!acc || acc.timeLogs.length === 0) {
                tbody.innerHTML = `<tr><td colspan="6" class="px-6 py-4 text-center text-gray-500">No time entries logged yet.</td></tr>`;
                return;
            }
            tbody.innerHTML = acc.timeLogs.map(l => {
                const client = acc.clients.find(c => c.id === l.clientId);
                const task = acc.tasks.find(t => t.id === l.taskId)?.name || 'General Task';
                return `<tr><td class="px-6 py-4">${l.date}</td><td class="px-6 py-4 font-medium">${client?.name || 'Unknown'}</td><td class="px-6 py-4">${task}</td><td class="px-6 py-4">${l.hours} hrs</td><td class="px-6 py-4">${l.billable ? 'Yes' : 'No'}</td><td class="px-6 py-4"><button onclick="deleteLog('${l.id}')" class="text-red-600">Delete</button></td></tr>`;
            }).join('');
        }

        window.deleteLog = function(id) {
            const acc = getActiveAccount();
            if (!acc) return;
            acc.timeLogs = acc.timeLogs.filter(l => l.id !== id);
            window.saveAccounts();
        };

